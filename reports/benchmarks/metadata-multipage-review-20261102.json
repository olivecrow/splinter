{
  "schemaVersion": 1,
  "id": "ST-52",
  "dateLocal": "2026-11-02",
  "scope": "Review of the proposed immutable multi-entry B+ tree; no production implementation or format change.",
  "decision": "Do not replace the current general metadata store with this proposal yet. Bulk byte savings are credible, but canonical incremental boundaries and sparse-update cost are not established. This is deferral, not rejection of every multi-entry tree.",
  "baseline": "72601d6 plus the current completed ST-44-51 working-tree changes, SPM2",
  "findings": [
    {
      "kind": "confirmed current code",
      "location": "PagedMetadataStore.WriteNode/Flush/Build",
      "finding": "Each key has a page header, but pages already append to shared containers. Bulk build writes each node once and durable page flush is at root publication, not once per node. Smaller page count cannot be treated as the same reduction in fsync count."
    },
    {
      "kind": "small model counterexample",
      "location": "artifacts/multipage-review-20261102/model.py",
      "finding": "Byte-greedy packing gives canonical full builds but inserts/deletes can shift all later page boundaries. This is one simple completion of the unspecified rule, not the user proposal implemented or a general B+ impossibility proof."
    },
    {
      "kind": "confirmed contract coupling",
      "location": "PagedMetadataStore.LogicalHash; CopyRootsToCore; PagedMetadataStoppedAudit",
      "finding": "Logical hashes include left/right/owned-child hashes and counts. Repacking preserves logical identity; collection and stopped audit enumerate the same edges and reject forward/cyclic references. A multi-entry leaf must carry every owned child, and internal node counts must support Rank/EntryAt. Replacing only lookup/encoding would be incomplete."
    },
    {
      "kind": "adoption gate",
      "finding": "First specify deterministic boundaries that can be updated locally without full sorted-prefix repacking. Prove bulk/forward/reverse/random/update-delete identity, variable-byte cap and owner-child reachability. Then compare small data writes, physical reads, flushes and time including collection/recovery. No new large run is authorized."
    }
  ],
