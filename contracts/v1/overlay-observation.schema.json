{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:overlay-observation",
  "type": "object",
  "required": [
    "version",
    "token",
    "id",
    "phase",
    "observedAt",
    "processId",
    "snapshotId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "token": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "phase": {
      "enum": [
        "replaying",
        "mounted",
        "snapshot-missing",
        "snapshot-unknown",
        "unmounted",
        "failed"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "snapshotAvailability": {
      "enum": [
        "available",
        "missing",
        "unknown"
      ]
    },
    "snapshotFailureCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "snapshotId": {
      "type": "string"
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storeReadyTicks", "stopwatchFrequency"],
      "properties": {
        "storeReadyTicks": {"type":"integer", "minimum":0},
        "stopwatchFrequency": {"type":"integer", "minimum":1}
      }
    },
    "openHandles": {
      "type": "integer",
      "minimum": 0
    },
    "workingSetBytes": {
      "type": "integer",
      "minimum": 0
    },
    "privateBytes": {
      "type": "integer",
      "minimum": 0
    },
    "storage": {
      "type": ["object", "null"],
      "required": [
        "initialPayloadCopiedBytes",
        "journalBytes",
        "payloadBytes",
        "metadataBytes",
        "readBytes",
        "readCacheBytes",
        "durableSequence"
      ],
      "properties": {
        "journalOptimizationEnabled": { "type": "boolean" },
        "journalBytesBasis": { "enum": ["current-files", "writer-accounting"] },
        "initialPayloadCopiedBytes": {
          "const": 0
        },
        "readCacheBytes": {
          "const": 0
        },
        "journalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "payloadBytes": {
          "type": "integer",
          "minimum": 0
        },
        "metadataBytes": {
          "type": "integer",
          "minimum": 0
        },
        "readBytes": {
          "type": "integer",
          "minimum": 0
        },
        "durableSequence": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "epoch": {
              "type": "string",
              "minLength": 1
            },
            "lockAcquisitions": {
              "type": "integer",
              "minimum": 0
            },
            "lockWaitTicks": {
              "type": "integer",
              "minimum": 0
            },
            "flushCount": {
              "type": "integer",
              "minimum": 0
            },
            "flushTicks": {
              "type": "integer",
              "minimum": 0
            },
            "commitCount": {
              "type": "integer",
              "minimum": 0
            },
            "journalAppendedBytes": {
              "type": "integer",
              "minimum": 0
            },
            "replayBytes": {
              "type": "integer",
              "minimum": 0
            },
            "replayTicks": {
              "type": "integer",
              "minimum": 0
            },
            "replayFrames": {"type":"integer", "minimum":0},
            "replayReadCalls": {"type":"integer", "minimum":0},
            "replayReadTicks": {"type":"integer", "minimum":0},
            "replayValidationTicks": {"type":"integer", "minimum":0},
            "replayIndexTicks": {"type":"integer", "minimum":0},
            "replayBufferBytes": {"type":"integer", "minimum":0},
            "replayIndexOperations": {
              "type": "array", "maxItems": 9,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["operation", "frames", "applyTicks"],
                "properties": {
                  "operation": {"enum":["create","metadata","resize","write","write-compacted","rename","delete","skip-write","skip-range"]},
                  "frames": {"type":"integer", "minimum":1},
                  "applyTicks": {"type":"integer", "minimum":0}
                }
              }
            },
            "replayWriteRangeIndex": {
              "type": "object",
              "additionalProperties": false,
              "required": ["replaceCalls", "priorExtents", "maxPriorExtents", "visitedExtents",
                "copiedExtents", "locateAndReplaceTicks", "sortTicks", "priorExtentBuckets"],
              "properties": {
                "replaceCalls": {"type":"integer", "minimum":0},
                "priorExtents": {"type":"integer", "minimum":0},
                "maxPriorExtents": {"type":"integer", "minimum":0},
                "visitedExtents": {"type":"integer", "minimum":0},
                "copiedExtents": {"type":"integer", "minimum":0},
                "locateAndReplaceTicks": {"type":"integer", "minimum":0},
                "sortTicks": {"type":"integer", "minimum":0},
                "priorExtentBuckets": {
                  "type":"array", "minItems":6, "maxItems":6,
                  "items":{"type":"integer", "minimum":0}
                }
              }
            },
            "readRangeIndex": {
              "type": "object",
              "additionalProperties": false,
              "required": ["readCalls", "searchProbes", "visitedExtents"],
              "properties": {
                "readCalls": { "type": "integer", "minimum": 0 },
                "searchProbes": { "type": "integer", "minimum": 0 },
                "visitedExtents": { "type": "integer", "minimum": 0 }
              }
            },
            "liveJournalWrites": {
              "type": "object", "additionalProperties": false,
              "required": ["mutationGateCalls", "mutationGateWaitTicks", "operations"],
              "properties": {
                "mutationGateCalls": {"type":"integer", "minimum":0},
                "mutationGateWaitTicks": {"type":"integer", "minimum":0},
                "operations": {
                  "type":"array", "maxItems":7,
                  "items": {
                    "type":"object", "additionalProperties":false,
                    "required":["operation","attempts","durableCommits","failedCalls","payloadBytes","journalBytes","prepareTicks","appendTicks","flushTicks","applyTicks","totalTicks","flushCalls","maxWaitingMutations","waitingMutationsAtFlushStart","waitingMutationsAtFlushEnd"],
                    "properties": {
                      "operation": {"enum":["create","write","resize","metadata","rename","delete","forget-unlinked"]},
                      "attempts": {"type":"integer", "minimum":0},
                      "durableCommits": {"type":"integer", "minimum":0},
                      "failedCalls": {"type":"integer", "minimum":0},
                      "payloadBytes": {"type":"integer", "minimum":0},
                      "journalBytes": {"type":"integer", "minimum":0},
                      "prepareTicks": {"type":"integer", "minimum":0},
                      "appendTicks": {"type":"integer", "minimum":0},
                      "flushTicks": {"type":"integer", "minimum":0},
                      "applyTicks": {"type":"integer", "minimum":0},
                      "totalTicks": {"type":"integer", "minimum":0},
                      "flushCalls": {"type":"integer", "minimum":0},
                      "maxWaitingMutations": {"type":"integer", "minimum":0},
                      "waitingMutationsAtFlushStart": {"type":"array", "minItems":5, "maxItems":5, "items":{"type":"integer","minimum":0}},
                      "waitingMutationsAtFlushEnd": {"type":"array", "minItems":5, "maxItems":5, "items":{"type":"integer","minimum":0}}
                    }
                  }
                }
              }
            },
            "journalReadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "baseReadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "stopwatchFrequency": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "epoch",
            "lockAcquisitions",
            "lockWaitTicks",
            "flushCount",
            "flushTicks",
            "commitCount",
            "journalAppendedBytes",
            "replayBytes",
            "replayTicks",
            "journalReadBytes",
            "baseReadBytes",
            "stopwatchFrequency",
            "replayFrames",
            "replayReadCalls",
            "replayReadTicks",
            "replayValidationTicks",
            "replayIndexTicks",
            "replayBufferBytes",
            "replayIndexOperations",
            "replayWriteRangeIndex",
            "liveJournalWrites",
            "readRangeIndex"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "snapshotAvailability"
        ],
        "properties": {
          "snapshotAvailability": {
            "const": "available"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "mounted"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "snapshotAvailability"
        ],
        "properties": {
          "snapshotAvailability": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "snapshot-missing"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "snapshotAvailability"
        ],
        "properties": {
          "snapshotAvailability": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "phase": {
            "const": "snapshot-unknown"
          }
        }
      }
    }
  ]
}
