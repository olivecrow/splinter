{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-ensure-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "baseReference": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "const": "ntfs-snapshot"
    },
    "editor": {
      "type": "boolean"
    },
    "maxJournalBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 1099511627776
    }
  },
  "required": [
    "project",
    "key",
    "storage"
  ]
}
