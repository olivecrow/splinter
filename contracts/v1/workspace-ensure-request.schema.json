{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-ensure-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "baseReference": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "enum": [
        "refs-cow",
        "git-checkout"
      ]
    },
    "editor": {
      "type": "boolean"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    }
  },
  "required": [
    "project",
    "key",
    "storage"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "const": "refs-cow"
          }
        }
      },
      "then": {
        "required": [
          "baseline"
        ]
      },
      "else": {
        "not": {
          "required": [
            "baseline"
          ]
        }
      }
    }
  ]
}
