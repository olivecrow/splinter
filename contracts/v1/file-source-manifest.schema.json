{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:file-source-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ownerId",
    "requestDigest",
    "snapshotId",
    "identity",
    "catalog",
    "payloadIndex",
    "payloadPaths",
    "contentFiles"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "catalog": {
      "$ref": "urn:splinter:v1:snapshot-catalog"
    },
    "payloadIndex": {
      "$ref": "urn:splinter:v1:metadata-tree-root"
    },
    "payloadPaths": {
      "$ref": "urn:splinter:v1:metadata-tree-root"
    },
    "contentFiles": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "urn:splinter:v1:metadata-tree-root"
        }
      ]
    }
  }
}
