{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-result-generation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "requestKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resultReference": {
      "type": "string",
      "minLength": 1
    },
    "captureDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sourceSequence": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "gitReference": {
      "type": "string",
      "minLength": 1
    },
    "gitFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "sequence",
    "requestKey",
    "message",
    "revision",
    "fingerprint",
    "resultReference",
    "captureDigest",
    "sourceSequence",
    "createdAt"
  ]
}
