{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:source-change-view",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "sequence"
        ]
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "directory",
        "changes",
        "names",
        "managedPaths",
        "count",
        "caseSensitive",
        "contentHash"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "directory": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "$ref": "urn:splinter:v1:metadata-tree-root"
        },
        "names": {
          "$ref": "urn:splinter:v1:metadata-tree-root"
        },
        "contentNodes": {
          "$ref": "urn:splinter:v1:metadata-tree-root"
        },
        "managedPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contentCaptures": {
          "$ref": "urn:splinter:v1:metadata-tree-root"
        }
      }
    }
  },
  "required": [
    "workspaceId",
    "snapshotId",
    "epoch",
    "sequence",
    "changes"
  ],
  "oneOf": [
    {
      "required": [
        "index"
      ],
      "properties": {
        "changes": {
          "maxItems": 0
        }
      }
    },
    {
      "not": {
        "required": [
          "index"
        ]
      },
      "properties": {
        "changes": {
          "maxItems": 250000
        }
      },
      "$comment": "Inline lists belong to the explicit overlay-v2 development domain; product task-v4/overlay-v3 always uses the paged index."
    }
  ]
}
