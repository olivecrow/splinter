{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:source-change-view",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspaceId": {
      "type": "string",
      "minLength": 1
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "epoch": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "changes": {
      "type": "array",
      "maxItems": 250000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "sequence"
        ]
      }
    }
  },
  "required": [
    "workspaceId",
    "snapshotId",
    "epoch",
    "sequence",
    "changes"
  ]
}
