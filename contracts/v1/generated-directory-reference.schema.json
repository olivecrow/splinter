{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "projectPath",
    "relativePath",
    "snapshot",
    "receiptDirectory",
    "ownerId",
    "manifestHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1
    },
    "relativePath": {
      "const": "Library"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "sourcePath",
        "rootPath",
        "capturedAt",
        "persistent",
        "differential",
        "consistency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "const": "owned-directory"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "persistent": {
          "const": true
        },
        "differential": {
          "const": true
        },
        "consistency": {
          "const": "stopped-original-owned-directory"
        }
      }
    },
    "receiptDirectory": {
      "type": "string",
      "minLength": 1
    },
    "ownerId": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "manifestHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:generated-directory-reference"
}
