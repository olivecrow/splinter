{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-development-ensure-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "baseReference": {
      "type": "string",
      "minLength": 1
    },
    "storage": {
      "enum": [
        "ntfs-snapshot",
        "git-snapshot",
        "refs-cow",
        "git-checkout",
        "plastic-snapshot"
      ]
    },
    "editor": {
      "type": "boolean"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "maxJournalBytes": {
      "type": "integer",
      "minimum": 4096,
      "maximum": 1099511627776
    },
    "source": {
      "enum": [
        "git",
        "plastic",
        "none"
      ],
      "default": "git",
      "description": "Explicit durable source adapter. Failures never fall back."
    },
    "application": {
      "enum": [
        "unity",
        "none"
      ],
      "description": "Durable application selection. none requires no Editor or Unity metadata."
    },
    "libraryBasis": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{24}$"
    }
  },
  "required": [
    "project",
    "key",
    "storage"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "const": "refs-cow"
          },
          "source": {
            "const": "none"
          }
        }
      },
      "then": {
        "required": [
          "baseline"
        ]
      },
      "else": {
        "not": {
          "required": [
            "baseline"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "maxJournalBytes"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "const": "ntfs-snapshot"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "enum": [
              "none",
              "plastic"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "const": "ntfs-snapshot"
          },
          "baseReference": {
            "const": "snapshot"
          }
        },
        "not": {
          "required": [
            "baseline"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "application": {
            "const": "none"
          }
        },
        "required": [
          "application"
        ]
      },
      "then": {
        "properties": {
          "editor": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "const": "git-snapshot"
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "git"
          }
        },
        "not": {
          "required": [
            "baseline"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "plastic"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "oneOf": [
          {
            "properties": {
              "storage": {
                "const": "ntfs-snapshot"
              },
              "baseReference": {
                "const": "snapshot"
              }
            },
            "not": {
              "required": [
                "baseline"
              ]
            }
          },
          {
            "properties": {
              "storage": {
                "const": "plastic-snapshot"
              },
              "baseReference": {
                "type": "string",
                "pattern": "^[0-9]+@[^\\s]+$"
              }
            },
            "required": [
              "baseReference"
            ],
            "not": {
              "required": [
                "baseline"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "storage": {
            "const": "plastic-snapshot"
          }
        },
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "plastic"
          }
        },
        "required": [
          "source",
          "baseReference"
        ],
        "not": {
          "required": [
            "baseline"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "libraryBasis": {
            "type": "string"
          }
        },
        "required": [
          "libraryBasis"
        ]
      },
      "then": {
        "properties": {
          "storage": {
            "enum": [
              "git-snapshot",
              "plastic-snapshot"
            ]
          }
        }
      }
    }
  ]
}
