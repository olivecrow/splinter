{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:plastic-project-basis-receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "ownerId",
    "snapshot",
    "manifest",
    "manifestDigest",
    "released"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "sourcePath",
        "rootPath",
        "capturedAt",
        "persistent",
        "differential",
        "consistency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "const": "plastic-revisions"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pathPolicy": {
          "enum": [
            null,
            "posix-case-sensitive-v1"
          ]
        },
        "persistent": {
          "const": true
        },
        "differential": {
          "const": true
        },
        "consistency": {
          "const": "recorded-project-changeset-raw-revisions"
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "treeSpec",
        "repositoryId",
        "rootRevision",
        "rootGuid",
        "catalog",
        "repository"
      ],
      "properties": {
        "treeSpec": {
          "type": "string",
          "pattern": "^[0-9]+@[^\\s]+$"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "rootRevision": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "rootGuid": {
          "type": "string",
          "format": "uuid"
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^rep:"
        },
        "version": {
          "const": 2
        },
        "catalog": {
          "$ref": "urn:splinter:v1:snapshot-catalog"
        }
      }
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "released": {
      "type": "boolean"
    }
  }
}
