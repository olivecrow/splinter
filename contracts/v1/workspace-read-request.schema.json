{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "collection": {
      "enum": [
        "results",
        "applies",
        "imports",
        "plan",
        "files",
        "applied-paths",
        "conflicts",
        "preserved-scratch",
        "maintenance-residuals",
        "selection",
        "deferred-reclamation"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{24}$"
    },
    "planId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 525296
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "requestKey": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "storeScope": {
      "enum": [
        null,
        "workspace-history",
        "workspace-original",
        "workspace-import",
        "workspace-applied",
        "workspace-results",
        "shared",
        "content",
        "ranges",
        "content-references",
        "journal-packing",
        "journal-indices",
        "read-only-replay"
      ]
    }
  },
  "required": [
    "id",
    "collection",
    "pageSize"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-read-request"
}
