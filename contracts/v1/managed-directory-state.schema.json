{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "urn:splinter:v1:managed-directory-state",
  "required": [
    "version",
    "key",
    "basis",
    "originalPath",
    "compatibilityKey",
    "phase",
    "initialPayloadCopiedBytes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "basis": {
      "$ref": "urn:splinter:v1:generated-directory-reference"
    },
    "originalPath": {
      "type": "string",
      "minLength": 1
    },
    "compatibilityKey": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "enum": [
        "preparing",
        "ready",
        "restoring",
        "restored"
      ]
    },
    "mount": {
      "type": [
        "object",
        "null"
      ]
    },
    "initialPayloadCopiedBytes": {
      "const": 0
    }
  }
}
