{
  "schemaVersion": "1.0",
  "commands": [
    {
      "id": "snapshot.spike",
      "description": "Operate an explicitly prepared NTFS snapshot-overlay experiment; not the workspace backend.",
      "cliUsage": "splinter-dev snapshot-spike --input <request.json>",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:snapshot-spike-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-experimental-mount-git-and-editor",
      "retry": "same-persisted-overlay-and-git-receipts; candidate-export requires stable publication requestKey and same frozen-source intent; inspect-uncertain-intents",
      "developmentOnly": true
    },
    {
      "id": "capabilities",
      "description": "List implemented commands and unavailable runtime capabilities.",
      "cliUsage": "splinter capabilities",
      "inputTransport": "none",
      "inputSchema": "urn:splinter:v1:empty-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "safe-read"
    },
    {
      "id": "schema",
      "description": "Read one implemented command's input, output and effect contract.",
      "cliUsage": "splinter schema <command>",
      "inputTransport": "positional-arguments",
      "inputSchema": "urn:splinter:v1:schema-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "safe-read"
    },
    {
      "id": "doctor",
      "description": "Read the explicitly selected source/application environment; no capture, launch or execution qualification.",
      "cliUsage": "splinter doctor --project <path> [--source git|none|plastic] [--application unity|none]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:doctor-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-process",
      "retry": "safe-read"
    },
    {
      "id": "workspace.ensure",
      "description": "Create or resume an isolated range workspace from a recorded Git/Plastic version or prepared project basis.",
      "cliUsage": "splinter workspace ensure --project <path> --key <task-key> --storage <git-snapshot|plastic-snapshot|project-snapshot> [--source git|none|plastic] [--application unity|none] [--base <reference>] [--editor] [--home <state-root>] [--library-basis <id>] [--project-basis <id>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-ensure-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-worktree-and-optional-editor",
      "retry": "same-project-and-task-key"
    },
    {
      "id": "workspace.list",
      "description": "List persisted task workspaces, including released results.",
      "cliUsage": "splinter workspace list [--project <directory>] [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-list-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-state",
      "retry": "safe-read"
    },
    {
      "id": "workspace.status",
      "description": "Observe owned resources; --verify-source checks current contents, --audit-source performs the full audit.",
      "cliUsage": "splinter workspace status --id <id> [--verify-source] [--home <state-root>] [--audit-source]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-status-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "reconcile-owned-state",
      "retry": "safe-read"
    },
    {
      "id": "workspace.compact",
      "description": "Explicitly compact an idle NTFS workspace and select current-state journal storage for subsequent writes, then reconnect the same snapshot and workspace.",
      "cliUsage": "splinter workspace compact --id <id> [--max-estimated-journal-overlap-bytes <bytes>] [--revert-base-ranges <true|false>] [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-compact-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-journal-generation-replacement",
      "retry": "same-workspace-compaction-intent"
    },
    {
      "id": "workspace.checkpoint",
      "description": "Capture one immutable independent source generation while retaining the task and running Editor; optionally stop and reclaim for final preservation.",
      "cliUsage": "splinter workspace checkpoint --id <id> --request-key <key> --message <message> [--release] [--home <home>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-checkpoint-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-generation-pins-independent-results; optional-owned-editor-stop-and-reclamation",
      "retry": "same-workspace-request-key-and-message; never recapture a later source for an existing request"
    },
    {
      "id": "workspace.integrate",
      "description": "Conditionally publish an exact source generation to the original without moving Git HEAD/index; explicit clean-target Git branch merge remains separate.",
      "cliUsage": "splinter workspace integrate --id <id> --target original --result <id> [--plan | --intent-key <key> --expected-plan-digest <digest>] [--path <path>] [--live-original <receipt.json>] [--home <home>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-integrate-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "plan:read-only; original:conditional-per-path-publication-without-Git-HEAD-index-mutation; branch:explicit-clean-target-Git-merge; Plastic:no-server-mutation",
      "retry": "same-result-intent-digest-selection-and-live-original-identity; completed requests never republish"
    },
    {
      "id": "workspace.release",
      "description": "Preserve the independent result and release owned resources; a blocked snapshot remains reclaim-pending until an explicit retry.",
      "cliUsage": "splinter workspace release --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-release-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-and-worktree-removal",
      "retry": "idempotent-release"
    },
    {
      "id": "workspace.discard",
      "description": "Explicitly discard this NTFS task without collecting a result; preserve the original, peers and independent results.",
      "cliUsage": "splinter workspace discard --id <id> --intent-key <key> --expected-request-digest <digest> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-discard-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-task-discard",
      "retry": "same-discard-intent"
    },
    {
      "id": "unity.start",
      "description": "Start or reconnect to this workspace private Editor using its exact patch version.",
      "cliUsage": "splinter unity start --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:unity-start-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-start",
      "retry": "same-workspace"
    },
    {
      "id": "unity.stop",
      "description": "Stop only the owned Editor while retaining source and workspace for later turns.",
      "cliUsage": "splinter unity stop --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:unity-stop-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-stop",
      "retry": "idempotent-stop"
    },
    {
      "id": "preparation.probe",
      "description": "Development-only interruption gate in product workspace.ensure; returns its ordinary response and retains all resources.",
      "cliUsage": "splinter-dev preparation-probe --input <request.json>",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:preparation-probe-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-ntfs-preparation-and-new-boundary-signal",
      "retry": "new-evidence-path; resume-with-original-workspace.ensure",
      "developmentOnly": true
    },
    {
      "id": "view.execute",
      "description": "Development-only immutable source views and shared Library cache lifetimes; project validation uses external tools.",
      "cliUsage": "splinter-dev view --input <request.json> [--home <path>]",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:view-lifecycle-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-immutable-candidate-view-editor-and-result",
      "retry": "same-request-key-and-owner; preserve-unknown-resources",
      "developmentOnly": true
    },
    {
      "id": "library.prepare",
      "description": "Move the stopped original Library without copying and mount private original writes.",
      "cliUsage": "splinter library prepare --project <path> --key <key> --home <path>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:library-prepare-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-original-library-lifecycle",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "library.status",
      "description": "Read the exact original Library basis lifecycle state.",
      "cliUsage": "splinter library status --id <id> --home <path>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:library-status-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "library.restore",
      "description": "Restore the original Library by file moves and private range writes after dependents are released.",
      "cliUsage": "splinter library restore --id <id> --home <path>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:library-restore-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-original-library-lifecycle",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "project.prepare",
      "description": "Explicit VCS-free original project basis prepare; same-volume rename and range restoration.",
      "cliUsage": "splinter project prepare --project <path> --key <key> --home <path> [--application none|unity]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:project-prepare-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-original-project-lifecycle",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "project.status",
      "description": "Read the exact persisted VCS-free project basis identity and phase; not a live mount health certificate.",
      "cliUsage": "splinter project status --id <id> --home <path>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:project-status-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "project.restore",
      "description": "Explicit VCS-free original project basis restore; same-volume rename and range restoration.",
      "cliUsage": "splinter project restore --id <id> --home <path>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:project-restore-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-original-project-lifecycle",
      "retry": "same-id-home-key-and-plan; preserve-unknown-side-effects"
    },
    {
      "id": "workspace.read",
      "description": "Read one bounded page of immutable results, publication history, fixed plans or file state using a root-bound cursor.",
      "cliUsage": "splinter workspace read --id <id> --collection <results|applies|plan|files|applied-paths|conflicts|preserved-scratch|maintenance-residuals|selection|deferred-reclamation> [--result <id>] [--plan-id <digest>] [--request-key <key> --store-scope <scope>] [--cursor <cursor>] [--page-size <1..1024>] [--home <path>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-read-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "same-root-and-cursor; reject stale cursors rather than mix generations"
    },
    {
      "inputSchema": "urn:splinter:v1:workspace-maintain-request",
      "cliUsage": "splinter workspace maintain --id <id> --request-key <key> [--scope workspace|shared|content|ranges|all] [--home <path>]",
      "outputSchema": "urn:splinter:v1:response",
      "description": "Reclaim unreferenced owned metadata with fixed roots, native file identities and same-request recovery; preserves independent results and unknown scratch.",
      "inputTransport": "options",
      "id": "workspace.maintain",
      "retry": "same-id-home-request-key-and-scope; resume-pending-before-new-mutations; completed-retry-receipt-only",
      "sideEffects": "owned-metadata-reclamation"
    }
  ]
}
