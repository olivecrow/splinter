{
  "schemaVersion": "1.0",
  "commands": [
    {
      "id": "snapshot.spike",
      "description": "Operate an explicitly prepared NTFS snapshot-overlay experiment; not the workspace backend.",
      "cliUsage": "splinter-dev snapshot-spike --input <request.json>",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:snapshot-spike-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-experimental-mount-git-and-editor",
      "retry": "same-persisted-overlay-and-git-receipts; candidate-export requires stable publication requestKey and same frozen-source intent; inspect-uncertain-intents",
      "developmentOnly": true
    },
    {
      "id": "capabilities",
      "description": "List implemented commands and unavailable runtime capabilities.",
      "cliUsage": "splinter capabilities",
      "inputTransport": "none",
      "inputSchema": "urn:splinter:v1:empty-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "safe-read"
    },
    {
      "id": "schema",
      "description": "Read one implemented command's input, output and effect contract.",
      "cliUsage": "splinter schema <command>",
      "inputTransport": "positional-arguments",
      "inputSchema": "urn:splinter:v1:schema-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "none",
      "retry": "safe-read"
    },
    {
      "id": "doctor",
      "description": "Read the explicitly selected source/application environment; no capture, launch or execution qualification.",
      "cliUsage": "splinter doctor --project <path> [--source git|none|plastic] [--application unity|none]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:doctor-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-process",
      "retry": "safe-read"
    },
    {
      "id": "workspace.ensure",
      "description": "Create or resume the explicitly selected Git or plain-folder NTFS workspace. No fallback or initial data clone.",
      "cliUsage": "splinter workspace ensure --project <path> --key <task-key> --storage ntfs-snapshot [--source git|none|plastic] [--application unity|none] [--base <reference>] [--editor] [--home <state-root>] [--max-journal-bytes <bytes>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-ensure-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-worktree-and-optional-editor",
      "retry": "same-project-and-task-key"
    },
    {
      "id": "workspace.list",
      "description": "List persisted task workspaces, including released results.",
      "cliUsage": "splinter workspace list [--project <directory>] [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-list-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-state",
      "retry": "safe-read"
    },
    {
      "id": "workspace.status",
      "description": "Observe owned resources; --verify-source checks current contents, --audit-source performs the full audit.",
      "cliUsage": "splinter workspace status --id <id> [--verify-source] [--home <state-root>] [--audit-source]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-status-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "reconcile-owned-state",
      "retry": "safe-read"
    },
    {
      "id": "workspace.compact",
      "description": "Explicitly compact an idle NTFS workspace journal before result collection, with an optional estimated journal overlap budget, then reconnect the same snapshot and workspace.",
      "cliUsage": "splinter workspace compact --id <id> [--max-estimated-journal-overlap-bytes <bytes>] [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-compact-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-journal-generation-replacement",
      "retry": "same-workspace-compaction-intent"
    },
    {
      "id": "workspace.checkpoint",
      "description": "Stop the owned application and preserve an independent source result; no compile claim.",
      "cliUsage": "splinter workspace checkpoint --id <id> --message <message> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-checkpoint-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-source-commit",
      "retry": "same-workspace-and-source"
    },
    {
      "id": "workspace.integrate",
      "description": "Integrate an exact Git result into its clean branch, or explicitly plan/apply a plain-folder result to its fixed original (editorless Windows NTFS).",
      "cliUsage": "splinter workspace integrate --id <id> [--target <Git-branch|original>] [--plan | --intent-key <key> --expected-plan-digest <digest>] [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-integrate-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "plan:read-only; Git:original-target-merge; plain-folder:conditional-per-path-publication",
      "retry": "Git:same-workspace-and-target; plain-folder:exact-intent-and-plan-digest"
    },
    {
      "id": "workspace.release",
      "description": "Preserve the independent result and release owned resources; a blocked snapshot remains reclaim-pending until an explicit retry.",
      "cliUsage": "splinter workspace release --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-release-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-and-worktree-removal",
      "retry": "idempotent-release"
    },
    {
      "id": "workspace.discard",
      "description": "Explicitly discard this NTFS task without collecting a result; preserve the original, peers and independent results.",
      "cliUsage": "splinter workspace discard --id <id> --intent-key <key> --expected-request-digest <digest> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:workspace-discard-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-task-discard",
      "retry": "same-discard-intent"
    },
    {
      "id": "unity.start",
      "description": "Start or reconnect to this workspace private Editor using its exact patch version.",
      "cliUsage": "splinter unity start --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:unity-start-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-start",
      "retry": "same-workspace"
    },
    {
      "id": "unity.stop",
      "description": "Stop only the owned Editor while retaining source and workspace for later turns.",
      "cliUsage": "splinter unity stop --id <id> [--home <state-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:unity-stop-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-editor-stop",
      "retry": "idempotent-stop"
    },
    {
      "id": "storage.service.status",
      "description": "Inspect the installed storage authority and caller elevation without creating snapshots or prompting for elevation.",
      "cliUsage": "splinter storage service status",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:storage-service-status-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-process",
      "retry": "safe-read"
    },
    {
      "id": "storage.probe",
      "description": "Check ReFS volume and cluster geometry without copying files.",
      "cliUsage": "splinter-dev storage probe --path <directory>",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:storage-probe-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "read-only-local-process",
      "retry": "safe-read",
      "developmentOnly": true
    },
    {
      "id": "baseline.prepare",
      "description": "Create or reconnect to one exact-revision baseline preparation Editor.",
      "cliUsage": "splinter-dev baseline prepare --project <repository> [--base development] [--home <ReFS-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:baseline-prepare-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-worktree-and-optional-editor",
      "retry": "same-project-and-task-key",
      "developmentOnly": true
    },
    {
      "id": "baseline.seal",
      "description": "Stop the owned preparation Editor, seal unchanged source and Library, then release its worktree; no compile claim.",
      "cliUsage": "splinter-dev baseline seal --id <id> [--home <ReFS-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:baseline-seal-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-baseline-cache",
      "retry": "same-workspace",
      "developmentOnly": true
    },
    {
      "id": "baseline.release",
      "description": "Reclaim a sealed cache only after every consumer is released.",
      "cliUsage": "splinter-dev baseline release --id <id> [--home <ReFS-root>]",
      "inputTransport": "options",
      "inputSchema": "urn:splinter:v1:baseline-release-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-baseline-removal",
      "retry": "idempotent-release",
      "developmentOnly": true
    },
    {
      "id": "preparation.probe",
      "description": "Development-only interruption gate in product workspace.ensure; returns its ordinary response and retains all resources.",
      "cliUsage": "splinter-dev preparation-probe --input <request.json>",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:preparation-probe-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-ntfs-preparation-and-new-boundary-signal",
      "retry": "new-evidence-path; resume-with-original-workspace.ensure",
      "developmentOnly": true
    },
    {
      "id": "view.execute",
      "description": "Development-only immutable source views and shared Library cache lifetimes; project validation uses external tools.",
      "cliUsage": "splinter-dev view --input <request.json> [--home <path>]",
      "inputTransport": "json-file",
      "inputSchema": "urn:splinter:v1:validation-product-request",
      "outputSchema": "urn:splinter:v1:response",
      "sideEffects": "owned-validation-candidate-view-editor-and-result",
      "retry": "same-request-key-and-owner; preserve-unknown-resources",
      "developmentOnly": true
    }
  ]
}
