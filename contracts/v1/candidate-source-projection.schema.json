{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:candidate-source-projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ownerId", "snapshot", "evidenceHash", "files"],
  "properties": {
    "version": {"const": 1},
    "ownerId": {"type": "string", "minLength": 1},
    "snapshot": {"$ref": "urn:splinter:v1:view-workflow-contract#/$defs/snapshot"},
    "evidenceHash": {"$ref": "#/$defs/hash"},
    "files": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "length", "contentHash"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 128,
            "pattern": "^[^/\\\\:\\u0000-\\u001f]+$", "not": {"pattern": "[. ]$"}},
          "length": {"type": "integer", "minimum": 1, "maximum": 4096},
          "contentHash": {"$ref": "#/$defs/hash"}
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
