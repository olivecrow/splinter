{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:source-change-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "managedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedGeneration": {
      "$ref": "urn:splinter:v1:source-change-view"
    },
    "contentPaths": {
      "uniqueItems": true,
      "maxItems": 4096,
      "items": {
        "minLength": 1,
        "maxLength": 32000,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "token",
    "requestId",
    "managedPaths"
  ],
  "dependentRequired": {
    "contentPaths": [
      "expectedGeneration"
    ],
    "expectedGeneration": [
      "contentPaths"
    ]
  }
}
