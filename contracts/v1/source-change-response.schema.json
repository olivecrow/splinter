{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:source-change-response",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "requestId", "processId", "processStartTimeUtcTicks", "view", "error"],
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "processId": { "type": "integer", "minimum": 1 },
    "processStartTimeUtcTicks": { "type": "integer", "minimum": 1 },
    "view": { "anyOf": [{ "$ref": "urn:splinter:v1:source-change-view" }, { "type": "null" }] },
    "error": { "type": ["string", "null"], "minLength": 1 }
  },
  "oneOf": [
    { "properties": { "view": { "type": "object" }, "error": { "type": "null" } } },
    { "properties": { "view": { "type": "null" }, "error": { "type": "string" } } }
  ]
}
