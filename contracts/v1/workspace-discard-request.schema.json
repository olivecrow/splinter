{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-discard-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intentKey", "expectedRequestDigest"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "intentKey": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S"},
    "expectedRequestDigest": {"type": "string", "pattern": "^[a-f0-9]{24}$"}
  }
}
