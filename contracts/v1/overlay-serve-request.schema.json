{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:overlay-serve-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "deltaPath",
    "mountPath",
    "controlPath",
    "token",
    "readAccess",
    "snapshotReceiptDirectory",
    "snapshotOwnerId"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "snapshot",
        "maxJournalBytes",
        "maxTransferBytes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxJournalBytes": {
          "type": "integer",
          "minimum": 4096
        },
        "maxTransferBytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 1048576
        },
        "excludedTopLevel": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[^/\\\\:]+$"
          },
          "uniqueItems": true
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "provider",
            "sourcePath",
            "rootPath",
            "capturedAt",
            "persistent",
            "differential",
            "consistency"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "const": "windows-vss-system"
            },
            "sourcePath": {
              "type": "string",
              "minLength": 1
            },
            "rootPath": {
              "type": "string",
              "minLength": 1
            },
            "capturedAt": {
              "type": "string",
              "format": "date-time"
            },
            "persistent": {
              "const": true
            },
            "differential": {
              "const": true
            },
            "consistency": {
              "const": "filesystem-crash-consistent-no-application-writer"
            }
          }
        },
        "includedTopLevel": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "deltaPath": {
      "type": "string",
      "minLength": 1
    },
    "mountPath": {
      "type": "string",
      "minLength": 1
    },
    "controlPath": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "pattern": "^([0-9a-f]{32}|[0-9a-f]{64})$"
    },
    "readAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotId",
        "rootPath",
        "verificationId"
      ],
      "properties": {
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "verificationId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "snapshotReceiptDirectory": {
      "type": "string",
      "minLength": 1
    },
    "snapshotOwnerId": {
      "type": "string",
      "minLength": 1
    },
    "validationView": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "candidatePath",
        "cacheDeltaPath",
        "cacheTopLevel",
        "cacheBasis"
      ],
      "properties": {
        "candidatePath": {
          "type": "string",
          "minLength": 1
        },
        "cacheDeltaPath": {
          "type": "string",
          "minLength": 1
        },
        "cacheBasis": {
          "enum": [
            "empty",
            "snapshot"
          ]
        },
        "cacheIdentity": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "id",
                "snapshot",
                "maxJournalBytes",
                "maxTransferBytes",
                "excludedTopLevel"
              ],
              "properties": {
                "version": {
                  "const": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "snapshot": {
                  "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/snapshot"
                },
                "maxJournalBytes": {
                  "type": "integer",
                  "minimum": 4096
                },
                "maxTransferBytes": {
                  "type": "integer",
                  "minimum": 4096,
                  "maximum": 1048576
                },
                "excludedTopLevel": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "includedTopLevel": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            }
          ]
        },
        "cacheTopLevel": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "Library",
              "Temp",
              "Logs",
              "UserSettings",
              "obj",
              ".vs",
              ".idea"
            ]
          }
        }
      }
    },
    "cacheSnapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "readAccess",
        "receiptDirectory",
        "ownerId"
      ],
      "properties": {
        "readAccess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "snapshotId",
            "rootPath",
            "verificationId"
          ],
          "properties": {
            "snapshotId": {
              "type": "string",
              "minLength": 1
            },
            "rootPath": {
              "type": "string",
              "minLength": 1
            },
            "verificationId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "receiptDirectory": {
          "type": "string",
          "minLength": 1
        },
        "ownerId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "validationView"
        ],
        "properties": {
          "validationView": {
            "type": "object",
            "required": [
              "cacheBasis"
            ],
            "properties": {
              "cacheBasis": {
                "const": "snapshot"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "cacheSnapshot"
        ],
        "properties": {
          "cacheSnapshot": {
            "type": "object"
          },
          "validationView": {
            "required": [
              "cacheIdentity"
            ],
            "properties": {
              "cacheIdentity": {
                "type": "object"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cacheSnapshot": {
            "type": "null"
          }
        }
      }
    }
  ]
}
