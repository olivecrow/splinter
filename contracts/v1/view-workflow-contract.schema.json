      "properties": {
        "cache": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/cache"
        },
        "owner": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/owner"
        },
        "currentGenerationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cacheReleased": {
          "type": "boolean"
        }
      }
    },
    "operationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request",
        "artifact",
        "response"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "request": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/request"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/response"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "projectId",
        "revision",
