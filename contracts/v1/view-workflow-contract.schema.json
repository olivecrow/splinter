              "type": "null"
            }
          ]
        },
        "released": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        },
        "closedViewId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "oneOf": [
        {
          "required": [
            "candidate"
          ],
          "properties": {
            "operation": {
              "const": "publish"
            },
            "candidate": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/publication"
            },
            "selection": {
              "type": "null"
            },
            "result": {
              "type": "null"
            },
            "released": {
              "type": "null"
            },
            "closedViewId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "selection"
          ],
          "properties": {
            "operation": {
              "const": "select"
            },
            "candidate": {
              "type": "null"
            },
            "selection": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/selection"
            },
            "result": {
              "type": "null"
            },
            "released": {
              "type": "null"
            },
            "closedViewId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "selection"
          ],
          "properties": {
            "operation": {
              "const": "resume"
            },
            "candidate": {
              "type": "null"
            },
            "selection": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/selection"
            },
            "result": {
              "type": "null"
            },
            "released": {
              "type": "null"
            },
            "closedViewId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "result"
          ],
          "properties": {
            "operation": {
              "const": "preserve"
            },
            "candidate": {
              "type": "null"
            },
            "selection": {
              "type": "null"
            },
            "result": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/result"
            },
            "released": {
              "type": "null"
            },
            "closedViewId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "result",
            "released"
          ],
          "properties": {
            "operation": {
              "const": "release"
            },
            "candidate": {
              "type": "null"
            },
            "selection": {
              "type": "null"
            },
            "result": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/result"
            },
            "released": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
            },
            "closedViewId": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "closedViewId"
          ],
          "properties": {
            "operation": {
              "const": "close-view"
            },
            "closedViewId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "candidate": {
              "type": "null"
            },
            "selection": {
              "type": "null"
            },
            "result": {
              "type": "null"
            },
            "released": {
              "type": "null"
            }
          }
        }
      ]
    },
    "candidateState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication",
        "result",
        "released"
      ],
      "properties": {
        "publication": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/publication"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/result"
            },
            {
              "type": "null"
            }
          ]
        },
        "released": {
          "type": "boolean"
        }
      }
    },
    "generationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection",
        "frozenSeal",
        "result",
        "released"
      ],
      "properties": {
        "selection": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/selection"
        },
        "frozenSeal": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/seal"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/result"
