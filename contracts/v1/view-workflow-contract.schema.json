{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:view-workflow-contract",
  "$defs": {
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "sourcePath",
        "rootPath",
        "capturedAt",
        "persistent",
        "differential",
        "consistency"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "rootPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pathPolicy": {
          "enum": [
            null,
            "posix-case-sensitive-v1"
          ]
        },
        "persistent": {
          "const": true
        },
        "differential": {
          "const": true
        },
        "consistency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durableSequence",
        "journalBytes",
        "journalHash"
      ],
      "properties": {
        "durableSequence": {
          "type": "integer",
          "minimum": 0
        },
        "journalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "journalHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceId",
        "owner",
        "snapshot",
        "sourceSeal"
      ],
      "properties": {
        "workspaceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/owner"
        },
        "snapshot": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/snapshot"
        },
        "sourceSeal": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/seal"
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewId",
        "cacheId",
        "snapshot",
        "compatibilityKey",
        "partitionKey",
        "maxJournalBytes",
        "snapshotBacked"
      ],
      "properties": {
        "viewId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "cacheId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "snapshot": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/snapshot"
        },
        "compatibilityKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "partitionKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "maxJournalBytes": {
          "type": "integer",
          "minimum": 4096
        },
        "snapshotBacked": {
          "type": "boolean"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "candidate",
            "source-generation"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "publicationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "projectId",
        "candidateId",
        "worker",
        "managedPathPolicy"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "worker": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/worker"
        },
        "managedPathPolicy": {
          "const": "source-only-v1"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "candidateSeal",
        "receiptId"
      ],
      "properties": {
        "intent": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/publicationIntent"
        },
        "candidateSeal": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/seal"
        },
        "receiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "selectionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "projectId",
        "generationId",
        "owner",
        "cache",
        "candidate"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/owner"
        },
        "cache": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/cache"
        },
        "candidate": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/publication"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "receiptId"
      ],
      "properties": {
        "intent": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/selectionIntent"
        },
        "receiptId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "owner",
        "snapshot",
        "seal"
      ],
      "properties": {
        "target": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
        },
        "owner": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/owner"
        },
        "snapshot": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/snapshot"
        },
        "seal": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/seal"
        }
      }
    },
    "preservationIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "projectId",
        "artifact"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/artifact"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "reference",
        "contentHash",
        "independentOfSnapshot"
      ],
      "properties": {
        "intent": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/preservationIntent"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "independentOfSnapshot": {
          "const": true
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "projectId",
        "requestKey",
        "owner"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operation": {
          "enum": [
            "publish",
            "select",
            "resume",
            "preserve",
            "release",
            "close-view"
          ]
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "requestKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "owner": {
          "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/owner"
        },
        "worker": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/worker"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidateId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cache": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/cache"
            },
            {
              "type": "null"
            }
          ]
        },
        "generationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "worker"
          ],
          "properties": {
            "operation": {
              "const": "publish"
            },
            "worker": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/worker"
            },
            "candidateId": {
              "type": "null"
            },
            "cache": {
              "type": "null"
            },
            "generationId": {
              "type": "null"
            },
            "target": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "candidateId",
            "cache"
          ],
          "properties": {
            "operation": {
              "const": "select"
            },
            "worker": {
              "type": "null"
            },
            "candidateId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "cache": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/cache"
            },
            "generationId": {
              "type": "null"
            },
            "target": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "generationId"
          ],
          "properties": {
            "operation": {
              "const": "resume"
            },
            "worker": {
              "type": "null"
            },
            "candidateId": {
              "type": "null"
            },
            "cache": {
              "type": "null"
            },
            "generationId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "target": {
              "type": "null"
            }
          }
        },
        {
          "required": [
            "target"
          ],
          "properties": {
            "operation": {
              "const": "preserve"
            },
            "worker": {
              "type": "null"
            },
            "candidateId": {
              "type": "null"
            },
            "cache": {
              "type": "null"
            },
            "generationId": {
              "type": "null"
            },
            "target": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
            }
          }
        },
        {
          "required": [
            "target"
          ],
          "properties": {
            "operation": {
              "const": "release"
            },
            "worker": {
              "type": "null"
            },
            "candidateId": {
              "type": "null"
            },
            "cache": {
              "type": "null"
            },
            "generationId": {
              "type": "null"
            },
            "target": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/target"
            }
          }
        },
        {
          "required": [
            "cache"
          ],
          "properties": {
            "operation": {
              "const": "close-view"
            },
            "cache": {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/cache"
            },
            "worker": {
              "type": "null"
            },
            "candidateId": {
              "type": "null"
            },
            "generationId": {
              "type": "null"
            },
            "target": {
              "type": "null"
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "operationId",
        "operation",
        "replayed"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation": {
          "enum": [
            "publish",
            "select",
            "resume",
            "preserve",
            "release",
            "close-view"
          ]
        },
        "replayed": {
          "type": "boolean"
        },
        "candidate": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/publication"
            },
            {
              "type": "null"
            }
          ]
        },
        "selection": {
          "anyOf": [
            {
              "$ref": "urn:splinter:v1:view-workflow-contract#/$defs/selection"
            },
