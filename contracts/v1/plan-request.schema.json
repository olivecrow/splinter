{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:plan-request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "sourceSnapshotId", "policyRef", "tasks", "limits", "completion"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "projectId": { "$ref": "#/$defs/id" },
    "sourceSnapshotId": { "$ref": "#/$defs/id" },
    "policyRef": { "$ref": "#/$defs/id" },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["taskId", "goal", "dependsOn", "expectedPaths", "requiredCapabilities", "verification"],
        "properties": {
          "taskId": { "$ref": "#/$defs/id" },
          "goal": { "type": "string", "pattern": "\\S", "maxLength": 16000 },
          "dependsOn": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
          "expectedPaths": { "type": "array", "maxItems": 256, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
          "requiredCapabilities": { "type": "array", "uniqueItems": true, "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
          "verification": {
            "type": "object", "additionalProperties": false, "required": ["requiredTests"],
            "properties": {
              "requiredTests": {
                "type": "array", "maxItems": 256,
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["mode", "filter"],
                  "properties": {
                    "mode": { "type": "string", "minLength": 1, "maxLength": 128 },
                    "filter": { "type": "string", "minLength": 1, "maxLength": 1024 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxWorkers", "maxEditors", "maxAttemptsPerTask"],
      "properties": {
        "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxEditors": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxAttemptsPerTask": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "completion": {
      "type": "object", "additionalProperties": false,
      "required": ["collectResults", "integration", "applyToOriginal", "releaseSuccessfulWorkspaces"],
      "properties": {
        "collectResults": { "type": "boolean" },
        "integration": { "enum": ["none", "prepare-and-validate"] },
        "applyToOriginal": { "type": "boolean" },
        "releaseSuccessfulWorkspaces": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
