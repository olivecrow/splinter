{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:git-source-metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "basis", "revision", "tree", "catalog", "examinedBytes", "examinedFiles", "captureTicks", "clockFrequency", "contentHash"],
  "properties": {
    "version": { "const": 2 },
    "basis": {
      "allOf": [
        { "$ref": "urn:splinter:v1:generated-directory-reference" },
        { "not": { "required": ["sourceMetadataHash"] } }
      ]
    },
    "revision": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "tree": { "type": "string", "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$" },
    "catalog": { "$ref": "urn:splinter:v1:snapshot-catalog" },
    "examinedBytes": { "type": "integer", "minimum": 0 },
    "examinedFiles": { "type": "integer", "minimum": 0 },
    "captureTicks": { "type": "integer", "minimum": 0 },
    "clockFrequency": { "type": "integer", "minimum": 1 },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
