{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-integrate-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "boolean"
    },
    "intentKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "expectedPlanDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "plan": {
            "const": true
          }
        },
        "required": [
          "plan"
        ]
      },
      "then": {
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "const": "original"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "intentKey"
              ]
            },
            {
              "required": [
                "expectedPlanDigest"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "intentKey"
            ]
          },
          {
            "required": [
              "expectedPlanDigest"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "target",
          "intentKey",
          "expectedPlanDigest"
        ],
        "properties": {
          "target": {
            "const": "original"
          },
          "plan": {
            "const": false
          }
        }
      }
    }
  ]
}
