{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "command",
    "status",
    "terminal",
    "retryDisposition",
    "nextActions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "Succeeded",
        "Failed",
        "Accepted"
      ]
    },
    "terminal": {
      "type": "boolean"
    },
    "retryDisposition": {
      "enum": [
        "not-needed",
        "correct-request",
        "safe-to-retry",
        "requires-user-action"
      ]
    },
    "data": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {}
      }
    },
    "nextActions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "arguments",
          "requiresUserAction"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {
            "type": "object"
          },
          "requiresUserAction": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "required": [
          "data"
        ],
        "not": {
          "required": [
            "error"
          ]
        },
        "properties": {
          "retryDisposition": {
            "const": "not-needed"
          }
        }
      },
      "else": {
        "required": [
          "error"
        ],
        "not": {
          "required": [
            "data"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "capabilities"
          },
          "status": {
            "const": "Succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/capabilitiesData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "schema"
          },
          "status": {
            "const": "Succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/schemaData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "doctor"
          },
          "status": {
            "const": "Succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/doctorData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "plan.validate"
          },
          "status": {
            "const": "Succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/planData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "Accepted"
          }
        }
      },
      "then": {
        "properties": {
          "terminal": {
            "const": false
          },
          "nextActions": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "terminal": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.ensure"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.list"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workspaces",
              "observation"
            ],
            "properties": {
              "workspaces": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/workspaceSummary"
                }
              },
              "observation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.status"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.checkpoint"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.integrate"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "workspace.release"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "unity.start"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "unity.refresh"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "unity.stop"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "storage.probe"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "storage"
            ],
            "properties": {
              "storage": {
                "$ref": "#/$defs/storageProbe"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "baseline.prepare"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/workspaceView"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "baseline.seal"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseline"
            ],
            "properties": {
              "baseline": {
                "$ref": "#/$defs/baseline"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "baseline.release"
          },
          "status": {
            "enum": [
              "Succeeded",
              "Accepted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "phase"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-f0-9]{24}$"
              },
              "phase": {
                "const": "released"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "cliUsage",
        "inputTransport",
        "inputSchema",
        "outputSchema",
        "sideEffects",
        "retry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "cliUsage": {
          "type": "string",
          "minLength": 1
        },
        "inputTransport": {
          "enum": [
            "none",
            "positional-arguments",
            "options",
            "json-file"
          ]
        },
        "inputSchema": {
          "type": "string",
          "minLength": 1
        },
        "outputSchema": {
          "type": "string",
          "minLength": 1
        },
        "sideEffects": {
          "enum": [
            "none",
            "read-only-local-process",
            "owned-worktree-and-optional-editor",
            "read-only-local-state",
            "reconcile-owned-state",
            "owned-source-commit",
            "original-target-merge",
            "owned-editor-and-worktree-removal",
            "owned-editor-start",
            "owned-editor-compile",
            "owned-editor-stop",
            "owned-baseline-cache",
            "owned-baseline-removal"
          ]
        },
        "retry": {
          "enum": [
            "safe-read",
            "same-project-and-task-key",
            "same-workspace-and-source",
            "same-workspace-and-target",
            "idempotent-release",
            "same-workspace",
            "same-pending-request",
            "idempotent-stop"
          ]
        }
      }
    },
    "providerDetails": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "rootPath",
        "repositoryId",
        "details"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "$ref": "#/$defs/providerDetails"
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "rootPath",
        "version",
        "details"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "rootPath": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "$ref": "#/$defs/providerDetails"
        }
      }
    },
    "capabilitiesData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationStage",
        "commands",
        "unavailable",
        "persistentHost",
        "persistentState",
        "stateBackend",
        "storageModes"
      ],
      "properties": {
        "implementationStage": {
          "const": "internal-alpha"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/descriptor"
          }
        },
        "unavailable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "persistentHost": {
          "const": false
        },
        "persistentState": {
          "const": true
        },
        "stateBackend": {
          "const": "atomic-json-with-operation-locks"
        },
        "storageModes": {
          "type": "array",
          "items": {
            "enum": [
              "refs-cow",
              "git-checkout"
            ]
          }
        }
      }
    },
    "schemaData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "descriptor",
        "input",
        "output"
      ],
      "properties": {
        "descriptor": {
          "$ref": "#/$defs/descriptor"
        },
        "input": {
          "type": "object"
        },
        "output": {
          "type": "object"
        }
      }
    },
    "doctorData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hasCommit",
        "readyForExecution",
        "checksNotRun",
        "missingPrerequisites"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "application": {
          "$ref": "#/$defs/application"
        },
        "hasCommit": {
          "type": "boolean"
        },
        "readyForExecution": {
          "const": false
        },
        "checksNotRun": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missingPrerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "planData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskCount",
        "executionLayers",
        "validationScope",
        "readyForExecution",
        "checksNotRun"
      ],
      "properties": {
        "taskCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "executionLayers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "validationScope": {
          "const": "schema-and-dependency-graph"
        },
        "readyForExecution": {
          "const": false
        },
        "checksNotRun": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "workspaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requestKey",
        "projectPath",
        "path",
        "sourceReference",
        "baseReference",
        "phase",
        "createdAt",
        "updatedAt",
        "storageMode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "requestKey": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "baseReference": {
          "type": "string",
          "minLength": 1
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "pendingValidationId": {
          "type": "string",
          "minLength": 1
        },
        "resultRevision": {
          "type": "string",
          "minLength": 1
        },
        "integratedRevision": {
          "type": "string",
          "minLength": 1
        },
        "lastError": {
          "type": "string",
          "minLength": 1
        },
        "storageMode": {
          "enum": [
            "refs-cow",
            "git-checkout"
          ]
        },
        "processId": {
          "type": "integer",
          "minimum": 1
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "fingerprint",
            "success",
            "completedAt",
            "errors",
            "errorCount"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "success": {
              "type": "boolean"
            },
            "completedAt": {
              "type": "string",
              "minLength": 1
            },
            "errors": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string"
              }
            },
            "errorCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "purpose": {
          "enum": [
            "task",
            "baseline"
          ]
        },
        "baselineId": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "cloneMetrics": {
          "$ref": "#/$defs/cloneStatistics"
        },
        "releasedResources": {
          "$ref": "#/$defs/processResources"
        }
      }
    },
    "workspaceView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "controlPath",
        "nextCommand",
        "isolation"
      ],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspaceSummary"
        },
        "controlPath": {
          "type": "string",
          "minLength": 1
        },
        "nextCommand": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "fingerprint",
            "hasChanges",
            "changedPaths",
            "changedPathCount"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "minLength": 1
            },
            "fingerprint": {
              "type": "string",
              "minLength": 1
            },
            "hasChanges": {
              "type": "boolean"
            },
            "changedPaths": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "changedPathCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "application": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "running",
            "ready",
            "phase"
          ],
          "properties": {
            "running": {
              "type": "boolean"
            },
            "ready": {
              "type": "boolean"
            },
            "phase": {
              "type": "string",
              "minLength": 1
            },
            "processId": {
              "type": "integer",
              "minimum": 1
            },
            "validation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requestId",
                "fingerprint",
                "success",
                "completedAt",
                "errors",
                "errorCount"
              ],
              "properties": {
                "requestId": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "type": "string",
                  "minLength": 1
                },
                "success": {
                  "type": "boolean"
                },
                "completedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "errors": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "string"
                  }
                },
                "errorCount": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "resources": {
              "$ref": "#/$defs/processResources"
            }
          }
        }
      }
    },
    "processResources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownershipVerified",
        "rootRunning",
        "activeProcesses",
        "workingSetBytes",
        "privateBytes"
      ],
      "properties": {
        "ownershipVerified": {
          "type": "boolean"
        },
        "rootRunning": {
          "type": "boolean"
        },
        "activeProcesses": {
          "type": "integer",
          "minimum": 0
        },
        "workingSetBytes": {
          "type": "integer",
          "minimum": 0
        },
        "privateBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cloneStatistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalBytes",
        "clonedBytes",
        "copiedBytes",
        "files",
        "elapsedMilliseconds"
      ],
      "properties": {
        "logicalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "clonedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "copiedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMilliseconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "storageProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "volume",
        "fileSystem",
        "clusterBytes"
      ],
      "properties": {
        "mode": {
          "const": "refs-cow"
        },
        "volume": {
          "type": "string",
          "minLength": 1
        },
        "fileSystem": {
          "const": "ReFS"
        },
        "clusterBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "projectPath",
        "baseRevision",
        "compatibilityKey",
        "path",
        "sealedAt",
        "cloneMetrics",
        "manifestHash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1
        },
        "compatibilityKey": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sealedAt": {
          "type": "string",
          "minLength": 1
        },
        "cloneMetrics": {
          "$ref": "#/$defs/cloneStatistics"
        },
        "manifestHash": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
