{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:splinter:v1:plastic-source-receipt",
  "type":"object","additionalProperties":false,
  "required":["version","admission","path","snapshot"],
  "properties":{
    "version":{"const":1},"admission":{"$ref":"urn:splinter:v1:plastic-source-admission"},
    "path":{"type":"string","minLength":1},
    "snapshot":{
      "type":"object","additionalProperties":false,
      "required":["id","provider","sourcePath","rootPath","capturedAt","persistent","differential","consistency"],
      "properties":{
        "id":{"type":"string","minLength":1},"provider":{"type":"string","minLength":1},
        "sourcePath":{"type":"string","minLength":1},"rootPath":{"type":"string","minLength":1},
        "capturedAt":{"type":"string","format":"date-time"},
        "pathPolicy": {"enum": [null, "posix-case-sensitive-v1"]},"persistent":{"const":true},"differential":{"const":true},
        "consistency":{"type":"string","minLength":1}
      }
    }
  }
}
