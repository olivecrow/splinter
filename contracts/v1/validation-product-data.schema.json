{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:validation-product-data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "result"
  ],
  "properties": {
    "action": {
      "type": "string"
    },
    "result": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "publish",
            "select",
            "resume",
            "preserve",
            "release"
          ]
        },
        "result": {
          "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/response"
        }
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "prepare-worker"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker",
            "resources",
            "managedPathPolicy"
          ],
          "properties": {
            "worker": {
              "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/worker"
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ownershipVerified"
              ],
              "properties": {
                "ownershipVerified": {
                  "type": "boolean"
                },
                "applications": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "writers": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "openHandles": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "mounted": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            },
            "snapshotAvailable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "managedPathPolicy": {
              "const": "source-only-v1"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "status"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/state"
            },
            "resources": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "resources"
                  ],
                  "properties": {
                    "owner": {
                      "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/owner"
                    },
                    "resources": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "ownershipVerified"
                      ],
                      "properties": {
                        "ownershipVerified": {
                          "type": "boolean"
                        },
                        "applications": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "writers": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "openHandles": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "mounted": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              ]
            },
            "execution": {
              "type": [
                "object",
                "null"
              ]
            },
            "cacheMaintenance": {
              "anyOf": [
                {
                  "$ref": "urn:splinter:v1:validation-product-data#/$defs/cacheMaintenance"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "start"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection",
            "application",
            "controlPath",
            "path"
          ],
          "properties": {
            "selection": {
              "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/selection"
            },
            "application": {
              "type": "object"
            },
            "mount": {
              "type": "object"
            },
            "controlPath": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "stop"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection",
            "stopped",
            "seal",
            "controlPath"
          ],
          "properties": {
            "selection": {
              "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/selection"
            },
            "stopped": {
              "const": true
            },
            "seal": {
              "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/seal"
            },
            "controlPath": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "close-view"
          ]
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "viewId",
            "closed",
            "cachePresent",
            "mountPresent"
          ],
          "properties": {
            "viewId": {
              "type": "string"
            },
            "closed": {
              "const": true
            },
            "cachePresent": {
              "const": false
            },
            "mountPresent": {
              "const": false
            }
          }
        }
      }
    },
    {
      "properties": {
        "action": {
          "const": "compact-cache"
        },
        "result": {
          "allOf": [
            {
              "$ref": "urn:splinter:v1:validation-product-data#/$defs/cacheMaintenance"
            },
            {
              "required": [
                "after",
                "compaction"
              ],
              "properties": {
                "completed": {
                  "const": true
                },
                "after": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "journalBytes",
                    "retainedPayloadBytes",
                    "livePrivateBytes",
                    "obsoletePayloadBytes",
                    "frameBytes"
                  ],
                  "properties": {
                    "journalBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "retainedPayloadBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "livePrivateBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "obsoletePayloadBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "frameBytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                },
                "compaction": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "attemptId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before": {
                      "$ref": "urn:splinter:v1:response#/$defs/compactionSeal"
                    },
                    "after": {
                      "$ref": "urn:splinter:v1:response#/$defs/compactionSeal"
                    },
                    "startedAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "beforeAllocatedBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "afterAllocatedBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "peakTemporaryAllocatedBytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "cost": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "stopwatchFrequency": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "totalTicks": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "stages": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "stage": {
                                "type": "string",
                                "minLength": 1
                              },
                              "elapsedTicks": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "readBytes": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "writtenBytes": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "flushCount": {
                                "type": "integer",
                                "minimum": 0
                              }
                            },
                            "required": [
                              "stage",
                              "elapsedTicks",
                              "readBytes",
                              "writtenBytes",
                              "flushCount"
                            ]
                          }
                        }
                      },
                      "required": [
                        "stopwatchFrequency",
                        "totalTicks",
                        "stages"
                      ]
                    }
                  },
                  "required": [
                    "attemptId",
                    "before",
                    "after",
                    "startedAt"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "cacheMaintenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "requestKey",
        "cache",
        "maxEstimatedJournalOverlapBytes",
        "beforeSeal",
        "before",
        "completed"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "requestKey": {
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/cache"
        },
        "maxEstimatedJournalOverlapBytes": {
          "type": "integer",
          "minimum": 1
        },
        "beforeSeal": {
          "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/seal"
        },
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "journalBytes",
            "retainedPayloadBytes",
            "livePrivateBytes",
            "obsoletePayloadBytes",
            "frameBytes"
          ],
          "properties": {
            "journalBytes": {
              "type": "integer",
              "minimum": 0
            },
            "retainedPayloadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "livePrivateBytes": {
              "type": "integer",
              "minimum": 0
            },
            "obsoletePayloadBytes": {
              "type": "integer",
              "minimum": 0
            },
            "frameBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "compaction": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "attemptId": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "$ref": "urn:splinter:v1:response#/$defs/compactionSeal"
                },
                "after": {
                  "$ref": "urn:splinter:v1:response#/$defs/compactionSeal"
                },
                "startedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "beforeAllocatedBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "afterAllocatedBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "peakTemporaryAllocatedBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "cost": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "stopwatchFrequency": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "totalTicks": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "stages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "stage": {
                            "type": "string",
                            "minLength": 1
                          },
                          "elapsedTicks": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "readBytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "writtenBytes": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "flushCount": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "stage",
                          "elapsedTicks",
                          "readBytes",
                          "writtenBytes",
                          "flushCount"
                        ]
                      }
                    }
                  },
                  "required": [
                    "stopwatchFrequency",
                    "totalTicks",
                    "stages"
                  ]
                }
              },
              "required": [
                "attemptId",
                "before",
                "after",
                "startedAt"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "after": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "journalBytes",
                "retainedPayloadBytes",
                "livePrivateBytes",
                "obsoletePayloadBytes",
                "frameBytes"
              ],
              "properties": {
                "journalBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "retainedPayloadBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "livePrivateBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "obsoletePayloadBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "frameBytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "completed": {
          "type": "boolean"
        }
      }
    }
  }
}
