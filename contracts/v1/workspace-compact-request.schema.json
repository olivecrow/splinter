{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-compact-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "maxEstimatedJournalOverlapBytes": {
      "type": "integer",
      "minimum": 1
    },
    "revertBaseRanges": {
      "type": "boolean",
      "description": "Only at explicit compaction, remove private ranges equal to the fixed base. Default false; omitted retry uses saved option."
    }
  },
  "required": [
    "id"
  ]
}
