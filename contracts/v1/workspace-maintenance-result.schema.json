{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-maintenance-result",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "ownerId", "requestDigest", "requestKey", "scope", "phase", "stages"],
  "properties": {
    "version": {"const": 1},
    "ownerId": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "requestDigest": {"type": "string", "minLength": 1},
    "requestKey": {"type": "string", "minLength": 1, "maxLength": 128},
    "scope": {"enum": ["workspace", "shared", "content", "ranges", "all"]},
    "phase": {"enum": ["pending", "completed"]},
    "failureCode": {"type": ["string", "null"]},
    "stages": {
      "type": "array", "minItems": 1, "maxItems": 7,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope", "phase", "requestKey", "reclaimedBytes", "retainedBytes", "preservedEntries"],
        "properties": {
          "scope": {"enum": ["workspace-history", "workspace-original", "workspace-applied", "workspace-results", "shared", "content", "ranges"]},
          "phase": {"enum": ["pending", "completed", "absent"]},
          "store": {"type": ["string", "null"]},
          "requestKey": {"type": "string", "minLength": 1, "maxLength": 128},
          "reclaimedBytes": {"type": "integer", "minimum": 0},
          "retainedBytes": {"type": "integer", "minimum": 0},
          "preservedEntries": {"type": "integer", "minimum": 0},
          "preservedDirectory": {"type": ["string", "null"]},
          "preservedRoot": {"anyOf": [{"type": "null"}, {"$ref": "urn:splinter:v1:metadata-tree-root"}]}
        }
      }
    }
  }
}
