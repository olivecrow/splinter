{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:candidate-export-request",
  "type": "object", "additionalProperties": false,
  "required": ["version", "requestKey"],
  "properties": {
    "version": {"const": 1},
    "requestKey": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
