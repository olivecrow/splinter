{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:storage-authority-request",
  "type": "object", "additionalProperties": false,
  "required": ["version", "requestId", "operation", "ownerId", "sourcePath", "homePath", "snapshotId", "verification", "release"],
  "properties": {
    "version": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "operation": { "enum": ["Capture", "Observe", "Release"] },
    "ownerId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "sourcePath": { "type": "string", "minLength": 3 },
    "homePath": { "type": "string", "minLength": 3 },
    "snapshotId": { "type": ["string", "null"] },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "ownerId", "snapshotId", "requestedAt", "bootTimeUtc"],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "ownerId": { "type": "string", "minLength": 1 }, "snapshotId": { "type": ["string", "null"] },
        "requestedAt": { "type": "string", "format": "date-time" }, "bootTimeUtc": { "type": "string", "format": "date-time" }
      }
    },
    "release": { "anyOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "ownerId", "snapshot", "requestedAt", "bootTimeUtc"],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[0-9a-f]{32}$" }, "ownerId": { "type": "string", "minLength": 1 },
        "snapshot": { "$ref": "urn:splinter:v1:validation-workflow-contract#/$defs/snapshot" },
        "requestedAt": { "type": "string", "format": "date-time" }, "bootTimeUtc": { "type": "string", "format": "date-time" },
        "discard": { "anyOf": [{ "type": "null" }, { "$ref": "urn:splinter:v1:workspace-discard-state" }] }
      }
    }] }
  },
  "allOf": [
    { "if": { "properties": { "operation": { "const": "Capture" } } }, "then": { "properties": { "snapshotId": { "type": "null" } } }, "else": { "properties": { "snapshotId": { "type": "string", "minLength": 1 } } } },
    { "if": { "properties": { "operation": { "const": "Release" } } }, "then": { "properties": { "release": { "type": "object" } } }, "else": { "properties": { "release": { "type": "null" } } } }
  ]
}
