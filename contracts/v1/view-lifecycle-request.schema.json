{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:view-lifecycle-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "action",
    "project",
    "owner",
    "requestKey"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "action": {
      "enum": [
        "prepare-worker",
        "publish",
        "select",
        "resume",
        "preserve",
        "release",
        "status",
        "start",
        "stop",
        "close-view",
        "compact-cache"
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requestKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "viewId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "generationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "candidate",
            "source-generation"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      }
    },
    "maxJournalBytes": {
      "type": "integer",
      "minimum": 4096
    },
    "maxEstimatedJournalOverlapBytes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "action": {
          "enum": [
            "prepare-worker",
            "publish"
          ]
        }
      },
      "required": [
        "workspaceId"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "viewId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "select"
          ]
        }
      },
      "required": [
        "viewId",
        "candidateId"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "resume",
            "start",
            "stop"
          ]
        }
      },
      "required": [
        "generationId"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "viewId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "preserve",
            "release"
          ]
        }
      },
      "required": [
        "target"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "viewId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "status"
          ]
        }
      },
      "required": [],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "enum": [
            "close-view"
          ]
        }
      },
      "required": [
        "viewId"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          },
          {
            "required": [
              "maxEstimatedJournalOverlapBytes"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "action": {
          "const": "compact-cache"
        }
      },
      "required": [
        "viewId",
        "maxEstimatedJournalOverlapBytes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "workspaceId"
            ]
          },
          {
            "required": [
              "candidateId"
            ]
          },
          {
            "required": [
              "generationId"
            ]
          },
          {
            "required": [
              "target"
            ]
          },
          {
            "required": [
              "maxJournalBytes"
            ]
          }
        ]
      }
    }
  ]
}
