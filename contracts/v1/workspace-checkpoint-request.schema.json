{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-checkpoint-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "boolean",
      "default": false,
      "description": "Immediately release the range-journal workspace after preserving its independent result. Retries resume the same release; no automatic integration."
    }
  },
  "required": [
    "id",
    "message"
  ]
}
