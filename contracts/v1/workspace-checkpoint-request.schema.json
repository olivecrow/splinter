{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:splinter:v1:workspace-checkpoint-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{24}$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "boolean",
      "default": false,
      "description": "The agent saves externally; Splinter normally stops only the owned Editor, uses the same immutable-generation engine, then reclaims explicitly; never integrate automatically."
    },
    "requestKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "id",
    "message",
    "requestKey"
  ]
}
